# GEMINI_API_KEY: Optional for AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SUPABASE CLIENT CONFIGURATION (Safe for browser exposure via Vite)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# Provide either VITE_SUPABASE_PUBLISHABLE_KEY or VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE SERVER CONFIGURATION (Server-only - NEVER expose to browser)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Optional direct PostgreSQL connection string for automated migration runner (npm run db:setup)
DATABASE_URL=""

# SERVER SESSION SECRET (Used for local server-authoritative token signing when Supabase is not yet connected)
SESSION_SECRET="replace-with-a-long-random-secret-key"
